# 쇼핑몰 로컬 실행 설정 견본. 쓰려면 이 파일을 .env 로 복사한다 (.env 는 레포에 올라가지 않는다).
# 값을 비워 두면 docker-compose.dev.yml 의 기본값을 쓴다.
# 여기에는 로컬 개발용 값만 둔다. 실제 운영 비밀값 · mTLS 인증서는 절대 넣지 않는다.

# 호스트 포트 (다른 프로젝트와 겹칠 때만 바꾼다. 1로 시작하는 번호는 monimo-backend 와 같은 규칙)
# 기본 13306 · 16379
MYSQL_PORT=
REDIS_PORT=
# 기본 8090 · 8091 · 8092 · 8093 (게이트웨이 · 주문 · 결제 · 재고)
GATEWAY_PORT=
ORDER_PORT=
PAYMENT_PORT=
INVENTORY_PORT=

# 로컬 MySQL 계정 (기본: 사용자 shop / 비밀번호 shop)
MYSQL_USER=
MYSQL_PASSWORD=

# 주문 · 재고 서비스가 붙는 MySQL 호스트 · DB 이름 (bootRun 기준 기본 localhost · shop). compose 는 MYSQL_HOST 를 쓰지 않고 이미지 기본값 mysql 을 쓴다
MYSQL_HOST=
MYSQL_DATABASE=

# 재고 서비스가 붙는 Redis (bootRun 기준 기본 localhost · 16379). compose 는 이미지 기본값 redis · 6379 를 쓴다
REDIS_HOST=

# 결제 서비스가 부를 더미 외부 결제사(pg-stub) 주소 (bootRun 기준 기본 http://localhost:8099). compose 는 이미지 기본값 http://pg-stub:8080 을 쓴다
PG_BASE_URL=
# 결제사 스텁 호스트 포트 (기본 8099)
PG_STUB_PORT=

# 게이트웨이가 넘길 주문 서비스 주소 (bootRun 기준 기본 http://localhost:8091). compose 는 이미지 기본값 http://order:8091 을 쓴다
ORDER_BASE_URL=

# 게이트웨이 · 주문 서비스가 부를 재고 서비스 주소 (bootRun 기준 기본 http://localhost:8093). compose 는 이미지 기본값 http://inventory:8093 을 쓴다
INVENTORY_BASE_URL=

# 주문 서비스가 부를 결제 서비스 주소 (bootRun 기준 기본 http://localhost:8092). compose 는 이미지 기본값 http://payment:8092 를 쓴다
PAYMENT_BASE_URL=

# 스레드 덤프 Extension 이 Collector 에 명령을 받으러 갈 때 붙이는 토큰 (#34). Collector(monimo-backend)의 MONIMO_AGENT_TOKEN 과 같아야 한다
# 기본 local-agent-token (로컬 전용). Collector HTTP 주소는 Extension 기본값 http://collector:8081 (바꾸려면 OTEL_MONIMO_COLLECTOR_URL)
MONIMO_AGENT_TOKEN=

# 에이전트 mTLS (backend #159 · ADR #64). Collector 가 손님 신분증을 요구할 때(backend .env 의 COLLECTOR_TLS_CLIENT_AUTH=optional|require) 이 한 줄을 연다.
# backend compose 가 만든 인증서 폴더다. 네 서비스가 그 안의 env/shop-<서비스>.env 를 읽어 https://collector:4317 과 파일 셋(기관 인증서 · 자기 신분증 · 열쇠)을 받고,
# 폴더를 /certs 로 읽는다. 비워 두면(기본) 지금처럼 평문 http://collector:4317 이다. 인증서 파일은 이 레포에 두지 않는다.
# Collector 주소를 따로 바꾸는 변수(OTEL_EXPORTER_OTLP_ENDPOINT)는 #40 에서 뺐다 : 빈 값이 env_file 값을 덮어서 둘을 같이 둘 수 없다. 주소는 otel/agent.properties 에 있다
#MONIMO_OTLP_CERTS_DIR=../monimo-backend/certs
